SURVDOCKER_DATA_DIR=./survdocker/data
SURVDOCKER_CONFIG_DIR=./survdocker/config
SURVDOCKER_SYSTEM_CONFIG_DIR=./survdocker/system
SURVDOCKER_CONFIG_FILE=./survdocker/config/survdocker.yml
SURVDOCKER_SCAN_TOKEN=change-me
SURVDOCKER_HOST=0.0.0.0
SURVDOCKER_PORT=60000
SCAN_DAY=1
SCAN_TIME=06:00
SCAN_LOOKBACK=7d
TIMEZONE=Europe/Paris
MAX_LOG_LINES_PER_CONTAINER=50000
MAX_EXAMPLES_PER_ERROR=100
MAX_ERROR_GROUPS_PER_CONTAINER=5
REPORT_RETENTION_COUNT=4
# Used whenever TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are both non-empty;
# leave either blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
# Alternative to Telegram: point to a self-hosted Apprise API notify URL
# (e.g. https://apprise.example.com/notify/<config-key>/) instead of
# managing a bot token/chat id here. Used whenever APPRISE_URL is non-empty;
# leave it blank to disable. Both channels can be enabled at once.
APPRISE_URL=
APPRISE_TAG=
TRAEFIK_AUTH_MIDDLEWARE=my-geoblock@file,crowdsec-bouncer@docker,authelia_df@docker,sslheader@docker
SURVDOCKER_HOSTNAME=survdocker.denisflamant.com
